# Base images for benchopt-powered Codabench competitions, built and pushed
# by .github/workflows/images.yml:
#
#     ghcr.io/x-datascience-datacamp/codabench-benchopt      (CPU torch)
#     ghcr.io/x-datascience-datacamp/codabench-benchopt-gpu  (CUDA torch)
#
# A competition extends one with its requirements.txt (tools/Dockerfile).
FROM python:3.12-slim

# cu126 runs on any R525+ driver (cu128+ for Blackwell GPUs). The PyTorch
# wheels bundle the CUDA runtime, so no CUDA base image is needed.
ARG TORCH_CHANNEL=cpu
RUN pip install --no-cache-dir -U pip && pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/${TORCH_CHANNEL}
RUN pip install --no-cache-dir "benchopt>=1.10" pandas pyarrow scikit-learn

# Data staged on a self-hosted worker is bind-mounted read-only here.
ENV BENCHOPT_DATA_HOME=/app/data

RUN python -c "import benchopt, pandas, sklearn, torch"
